[1.6, "o", "\r\n"]
[1.65, "o", "==================================================================\r\n"]
[1.7, "o", "  LLM File Assistant - tool calling demo  (replay)\r\n"]
[1.75, "o", "==================================================================\r\n"]
[2.05, "o", "The assistant has 4 tools: list_files, read_file, search_in_file, write_file.\r\n"]
[2.35, "o", "Watch the [tool] lines - those are the LLM deciding which tool to call.\r\n"]
[3.95, "o", "\r\n"]
[4.0, "o", "==================================================================\r\n"]
[4.05, "o", "  1) Sample resumes (TXT, DOCX, PDF)\r\n"]
[4.1, "o", "==================================================================\r\n"]
