[1.6, "o", "\r\n"]
[0.05, "o", "==================================================================\r\n"]
[0.05, "o", "  LLM File Assistant - tool calling demo  (replay)\r\n"]
[0.05, "o", "==================================================================\r\n"]
[0.3, "o", "The assistant has 4 tools: list_files, read_file, search_in_file, write_file.\r\n"]
[0.3, "o", "Watch the [tool] lines - those are the LLM deciding which tool to call.\r\n"]
[1.6, "o", "\r\n"]
[0.05, "o", "==================================================================\r\n"]
[0.05, "o", "  1) Sample resumes (TXT, DOCX, PDF)\r\n"]
[0.05, "o", "==================================================================\r\n"]
