[0.05, "o", "==================================================================\r\n"]
[0.05, "o", "  3) list_files + search_in_file - keyword search across formats\r\n"]
[0.05, "o", "==================================================================\r\n"]
[1.0, "o", "\r\n"]
[0.2, "o", ">> QUERY: Find resumes mentioning Python experience and tell me how many match.\r\n"]
[0.1, "o", "------------------------------------------------------------------\r\n"]
[0.8, "o", "(using OpenRouter model: nvidia/nemotron-3-super-120b-a12b:free)\r\n"]
[0.9, "o", "[tool] list_files({\"directory\": \"./resumes\"})\r\n"]
[0.55, "o", "[tool] search_in_file({\"filepath\": \"./resumes/resume_aisha_khan.txt\", \"keyword\": \"Python\"})\r\n"]
